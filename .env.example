# Palm Wallet — PROTOTYPE configuration. Copy to .env and fill in the two secrets.
# NEVER use these values in any real deployment.

# --- runtime ---
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# --- storage ---
DATABASE_PATH=./data/palm-wallet.db

# --- secrets ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=REPLACE_WITH_BASE64_32_BYTES
TEMPLATE_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTES
TEMPLATE_KEY_ID=k1

# --- policy (piasters = 1/100 EGP) ---
FRESHNESS_WINDOW_MS=300000
MIN_PAYMENT_PIASTERS=100
MAX_PAYMENT_PIASTERS=5000000
MIN_DEPOSIT_PIASTERS=500
MAX_DEPOSIT_PIASTERS=1000000
JWT_TTL_SECONDS=43200

# --- bootstrap / demo ---
DEV_SETUP_TOKEN=local-setup-token
SEED_ON_BOOT=false
DEMO_MODE=true

# --- cors ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
